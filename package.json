{
  "name": "@jbrowse/graph-walks",
  "version": "8.0.2",
  "description": "Read gfa-to-tabix walk files by range requests and cut a window of a pangenome graph: the reference, every haplotype's walk through it, and the nodes and links they visit",
  "license": "MIT",
  "author": {
    "name": "Colin Diesh",
    "email": "colin.diesh@gmail.com",
    "url": "https://github.com/cmdcolin"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/graph-walks.git"
  },
  "keywords": [
    "pangenome",
    "graph",
    "gfa",
    "tabix",
    "haplotype"
  ],
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      }
    }
  },
  "files": [
    "esm"
  ],
  "scripts": {
    "build": "rm -rf esm && tsc -p tsconfig.build.json",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "prepack": "pnpm build",
    "preversion": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "postversion": "git push --follow-tags",
    "release-check": "vitest run --config release-check/vitest.config.ts",
    "blocks-equality": "node --max-old-space-size=3072 scripts/blocks-equality.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@gmod/tabix": "^3.13.1",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@gmod/bgzf-filehandle": "^6.8.2",
    "generic-filehandle2": "^2.5.1"
  }
}
